LITERATURE_ENABLED=false
LITERATURE_DATA_DIR=../.rag-data
# Optional versioned index; history and extraction records remain in LITERATURE_DATA_DIR.
# LITERATURE_LIBRARY_DIR=../.rag-data/index-versions/structure-v1
LITERATURE_TIMEOUT_SECONDS=300
LITERATURE_EXTRACTION_TIMEOUT_SECONDS=180
LITERATURE_DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=1800
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_LLM_PROVIDER=deepseek
RAG_LLM_MODEL=deepseek-flash
# Official API route currently serving DeepSeek-V4.1-Flash-1017.
RAG_LLM_THINKING_ENABLED=true
RAG_LLM_REASONING_EFFORT=high
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=
RAG_TOP_K=8
RAG_MIN_SCORE=0.35
RAG_CONTEXT_EXPANSION_ENABLED=true
RAG_CONTEXT_NEIGHBOR_RADIUS=1
RAG_CONTEXT_MAX_EVIDENCE_CHARS=8000
RAG_CONTEXT_MAX_TOTAL_CHARS=24000
# Optional MinerU classified index with table-row retrieval; requires a matching
# completed library (structure.json, Chroma and both table sidecars).
# RAG_CONTEXT_EXPANSION_STRATEGY=body_section
# RAG_TABLE_RETRIEVAL_ENABLED=true
# Optional original-PDF visual sidecar, matching Qwen3-VL embeddings and DeepSeek Flash.
RAG_VISUAL_RETRIEVAL_ENABLED=false
RAG_VISUAL_MAX_IMAGES=4
RAG_VISUAL_MAX_TOTAL_BYTES=12582912
# Optional isolated rerank experiment; disabled by default. Credentials are explicit.
RAG_RERANK_ENABLED=false
RAG_RERANK_PROVIDER=siliconflow
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_API_KEY=
RAG_RERANK_TIMEOUT_SECONDS=60
# Optional original + one rewritten query; requires reranking and configured DeepSeek.
# Reuses the answer model and credentials, with thinking disabled for the rewrite only.
RAG_QUERY_REWRITE_ENABLED=false
# dual: original + rewrite, rerank with original. rewrite_only: one rewritten
# search and rerank with that rewrite; rewrite failures do not fall back.
RAG_QUERY_REWRITE_MODE=dual
RAG_QUERY_REWRITE_TIMEOUT_SECONDS=30
# Optional response-completeness experiment; the control prompt remains the default.
RAG_ANSWER_GUIDANCE_ENABLED=false
# Optional one-pass, source-grounded DeepSeek review. Original drafts are retained on failure.
RAG_EVIDENCE_REVIEW_ENABLED=false
RAG_EVIDENCE_REVIEW_TIMEOUT_SECONDS=120
# Combined reasoning and final review output; the request timeout remains 120 seconds.
RAG_EVIDENCE_REVIEW_MAX_OUTPUT_TOKENS=32768
