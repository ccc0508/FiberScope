# Independent MinerU candidate; copy privately to .env.aliyun and fill keys.
# Build a new library with scripts/reembed_literature.py before selecting it.
LITERATURE_LIBRARY_DIR=../.rag-data/index-versions/mineru-qwen3-vl-20261102
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_MODEL=qwen3-vl-embedding
RAG_EMBEDDING_DIMENSIONS=2560
RAG_EMBEDDING_BATCH_SIZE=20
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RAG_EMBEDDING_API_KEY=
RAG_LLM_PROVIDER=deepseek
RAG_LLM_MODEL=deepseek-flash
RAG_LLM_THINKING_ENABLED=true
RAG_LLM_REASONING_EFFORT=high
RAG_LLM_API_KEY=
RAG_TOP_K=8
RAG_MIN_SCORE=0.35
RAG_CONTEXT_EXPANSION_ENABLED=true
RAG_CONTEXT_EXPANSION_STRATEGY=body_section
RAG_CONTEXT_MAX_EVIDENCE_CHARS=8000
RAG_CONTEXT_MAX_TOTAL_CHARS=24000
RAG_TABLE_RETRIEVAL_ENABLED=true
RAG_RERANK_ENABLED=true
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_API_KEY=
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MODE=dual
RAG_ANSWER_GUIDANCE_ENABLED=false
