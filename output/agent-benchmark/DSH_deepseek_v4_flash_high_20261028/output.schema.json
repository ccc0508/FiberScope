{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH full-system answer record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "answer",
    "claims",
    "citations"
  ],
  "properties": {
    "task_id": {
      "enum": [
        "PFI2-001",
        "PFI2-002",
        "PFI2-003",
        "PFI2-004",
        "PFI2-005",
        "PFI2-006",
        "PFI2-007",
        "PFI2-008",
        "PFI2-009",
        "PFI2-010",
        "PFI2-011",
        "PFI2-012",
        "PFI2-013",
        "PFI2-014",
        "PFI2-015",
        "PFI2-016",
        "PFI2-017",
        "PFI2-018",
        "PFI2-019",
        "PFI2-020",
        "PFI2-021",
        "PFI2-022",
        "PFI2-023",
        "PFI2-024",
        "PFI2-025",
        "PFI2-026",
        "PFI2-027",
        "PFI2-028",
        "PFI2-029",
        "PFI2-030",
        "PFI2-031",
        "PFI2-032"
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "citation_refs"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "citation_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^\\[[1-9][0-9]*\\]$"
            }
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "page_start",
          "page_end",
          "quote"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^\\[[1-9][0-9]*\\]$"
          },
          "page_start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          },
          "page_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
